build/
build2/
build_old2/
out/
out2/
out_test/
out_probe/
out_old*/

# Per-lane build dirs (gov-v7 / TANKOBAN_BUILD_LANE — Codex commission 07da143).
# Added 2026-05-22 after out_agent-4/ accumulated mid-build.
out_agent-*/

# Brainstorm-skill visual-companion mockups (per-session HTML files for the
# in-browser brainstorm preview). Persist locally for reference but not tracked.
.superpowers/

# Sidecar build artifacts (post-migration 2026-04-15). Sources are tracked
# under native_sidecar/; the build tree produced by build.ps1 is not.
native_sidecar/build/
resources/ffmpeg_sidecar/

# libmpv prebuilt (MPV_RENDER_API_INTEGRATION Phase 1, 2026-04-28) — fetched
# by setup.bat step 6 from shinchiro/mpv-winbuild-cmake. The DLL + import lib
# are platform binaries and not tracked. Headers under include/mpv/, the
# LICENSE file, and VERSION.txt ARE tracked so fresh clones still configure
# cleanly (CMake skips libmpv with a STATUS line if bin/libmpv-2.dll absent).
resources/libmpv/windows/bin/
resources/libmpv/windows/lib/
.vs/
.vscode/
*.user
CMakeSettings.json
CMakeUserPresets.json

# Large vendored assets — fetched/staged locally, not tracked
third_party/
models/

# REPO_HYGIENE Phase 2 (2026-04-26) — vcpkg manifest-mode install drops
# thousands of header files into a per-project dir at repo root. The
# manifest itself (vcpkg.json) IS tracked; the materialized install tree
# is not.
vcpkg_installed/

# Agent scratch: build scripts, logs, debug dumps — convention is underscore prefix
_*.bat
_*.txt
_*.log
_*.csv
_*/
*.log

# One-off diagnostic dumps agents generate at repo root (raw chat diffs, etc.)
chat_diff*.txt
*_raw.txt

# Exception: audit supersession directory is intentionally tracked (historical reference)
!agents/audits/_superseded/
!agents/audits/_superseded/**

# Congress-check hook local session markers — regenerated each run, not for git
.claude/.congress-warned-*

# Per-machine Claude Code config (NOT the shared settings.json).
# Added 2026-05-22 after .claude/settings.local.json appeared untracked.
.claude/settings.local.json

# .claude runtime state — lock files + telemetry are machine-local, regenerated
.claude/*.lock
.claude/telemetry/

# Compile artifacts from one-off probes outside the CMake build tree
*.obj

# build_check.bat manual-redirect dumps at repo root. The standard log lives
# under %BUILD_DIR%\_build_check.log (already gitignored via _*.log), but
# agents sometimes redirect via shell to repo-root files like
# build_check_out.txt or build_check_phase1_post_fixes.txt — those are
# per-debug artifacts and not for tracking.
build_check_*.txt
build_out.txt

# Sidecar debug log snapshots — sidecar_debug_live.log.pretask7 style
# suffixed copies agents make when capturing log state. The .log itself
# is already covered via *.log; this catches the snapshot suffixes.
sidecar_debug_live.log.*

# Playwright MCP cache (added 2026-05-15 with the playwright server in
# .mcp.json). First @playwright/mcp@latest invocation downloads Chromium
# here. Per-machine cache, not for tracking.
.playwright-mcp/

# Claude Code Exporter — auto-exported conversation transcripts (per-machine, never commit)
.cc-history/

# Root-level scratch convention (NOT the agent-scratch _*.{ext} convention above).
# tmp_* + loose smoke/wiki PNG scratch at root — saved evidence belongs under
# agents/audits/smoke_evidence/ via the smoke-package skill, not the repo root.
# Added 2026-05-22 after deathnote-volumes-fandom.png + wiki-dn-*.png + tmp_*
# accumulated at root from A1's fandom audit work.
/tmp_*
/wiki-*.png
/deathnote-*.png
